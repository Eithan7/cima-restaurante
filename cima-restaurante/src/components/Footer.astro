---
---
<footer class="bg-[#050505] text-neutral-400 py-8 sm:py-12 border-t border-white/5 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 gap-6 sm:gap-8 text-center md:grid-cols-3 md:text-left">
      
      <!-- Logo & Manifesto -->
      <div>
        <h3 class="text-xl sm:text-2xl font-cinzel text-white tracking-[0.2em] uppercase mb-3 sm:mb-4">CIMA</h3>
        <p class="font-light leading-relaxed text-sm mb-3 sm:mb-4 max-w-sm mx-auto md:mx-0">
          Alta gastronomía en la cima de la montaña. Una reverencia a los ingredientes orgánicos y la experiencia inmersiva.
        </p>
        <p class="text-orange-500 font-cinzel italic text-sm">Elevación: 1,900m</p>
      </div>

      <!-- Contact -->
      <div class="md:text-center">
        <h4 class="text-xs font-semibold text-white uppercase tracking-[0.2em] mb-4 sm:mb-6">Contacto</h4>
        <address class="not-italic font-light text-sm space-y-2 sm:space-y-3">
          <p>123 Ruta del Bosque Mágico<br/>Banff, AB T1L 1E1</p>
          <p><a href="tel:+14035550199" class="hover:text-orange-500 transition-colors duration-300">(403) 555-0199</a></p>
          <p><a href="mailto:info@cimarestaurante.com" class="hover:text-orange-500 transition-colors duration-300">reservations@cima.com</a></p>
        </address>
      </div>

      <!-- Hours -->
      <div class="md:text-right">
        <h4 class="text-xs font-semibold text-white uppercase tracking-[0.2em] mb-4 sm:mb-6">Horarios de Servicio</h4>
        <ul class="font-light text-sm space-y-2 sm:space-y-3">
          <li><strong>Brunch:</strong> 9:00 AM - 2:00 PM</li>
          <li><strong>Cena:</strong> 5:00 PM - 10:30 PM</li>
          <li class="pt-1 sm:pt-2 text-orange-500 italic font-cinzel text-sm">Con reservación previa</li>
        </ul>
      </div>

    </div>
    
    <div class="mt-8 sm:mt-12 pt-4 sm:pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between items-center text-xs tracking-widest uppercase">
      <p class="text-center md:text-left mb-4 md:mb-0">&copy; {new Date().getFullYear()} Cima Restaurante. Todos los derechos reservados.</p>
      <div class="flex space-x-4 sm:space-x-6">
        <!-- Social Media Icons -->
        <a href="#" class="hover:text-orange-500 transition-colors duration-300" aria-label="Instagram">
