---
interface Props {
  title: string;
  subtitle?: string;
  imagePath: string;
  ctaText?: string;
  ctaLink?: string;
  size?: 'large' | 'medium';
}

const { title, subtitle, imagePath, ctaText, ctaLink, size = 'large' } = Astro.props;
const heightClass = size === 'large' ? 'h-[100svh] min-h-[600px]' : 'h-[60svh] min-h-[400px] sm:min-h-[500px]';
---
<div class={`relative ${heightClass} flex items-center justify-center overflow-hidden`}>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0 bg-[#0a0a0a]">
    <img 
      src={imagePath} 
      alt="Vistas espléndidas desde CIMA" 
      class="w-full h-full object-cover opacity-60 animate-slow-zoom"
      loading={size === 'large' ? 'eager' : 'lazy'}
      fetchpriority={size === 'large' ? 'high' : 'auto'}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/80 via-transparent to-[#0a0a0a] pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent pointer-events-none"></div>
  </div>

  <div class="relative z-10 text-center px-3 sm:px-4 max-w-[1200px] w-full mx-auto mt-16 sm:mt-20 animate-fade-in opacity-0">
    <h1 class="font-cinzel text-3xl sm:text-4xl md:text-6xl lg:text-[7rem] xl:text-[9rem] text-white tracking-wider mb-4 sm:mb-6 drop-shadow-2xl font-normal leading-none mx-[-1rem] sm:mx-[-1.5rem] md:mx-[-2rem]">
      {size === 'large' ? 
        <><span class="whitespace-nowrap">DESCUBRE LA</span> <span class="text-gold-500 italic font-medium">CIMA</span></> 
        : title
      }
    </h1>
    
    <div class="flex items-center justify-center my-6 sm:my-8">
      <div class="h-[1px] w-8 sm:w-12 bg-orange-500"></div>
      <div class="mx-2 sm:mx-4 text-orange-500 text-sm sm:text-base">✧</div>
      <div class="h-[1px] w-8 sm:w-12 bg-orange-500"></div>
    </div>

    {subtitle && (
      <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-neutral-300 font-light tracking-wide max-w-2xl sm:max-w-3xl mx-auto leading-relaxed drop-shadow-lg px-2">
        {subtitle}
      </p>
    )}
    
    {ctaText && ctaLink && (
      <div class="mt-12 sm:mt-16 lg:mt-20">
        <a 
          href={ctaLink} 
          class="inline-block border border-gold-500 hover:border-orange-500 text-gold-500 hover:text-white px-6 sm:px-8 lg:px-12 py-3 sm:py-4 lg:py-5 uppercase tracking-[0.2em] text-xs sm:text-sm md:text-base font-medium transition-all duration-500 shadow-[0_0_15px_rgba(234,88,12,0.1)] hover:shadow-[0_0_25px_rgba(234,88,12,0.4)] hover:bg-orange-600 bg-black/40 backdrop-blur-sm"
        >
          {ctaText}
        </a>
      </div>
    )}
  </div>
</div>
