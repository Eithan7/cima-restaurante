---
interface MenuItem {
  name: string;
  description: string;
  price: string;
  tags?: string[];
  image?: string;
}

interface Props {
  title: string;
  items: MenuItem[];
}

const { title, items } = Astro.props;
---
<section class="bg-[#0a0a0a] text-white py-16 sm:py-24">
  <!-- Contenedor Principal con padding de seguridad -->
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
    
    <!-- Encabezado de Sección -->
    <div class="text-center mb-16 sm:mb-24">
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-cinzel tracking-[0.2em] uppercase mb-4">
        {title}
      </h2>
      <div class="w-20 h-[2px] bg-orange-600 mx-auto opacity-80"></div>
    </div>

    <!-- Grid de Platos: 1 columna en cel, 2 en tablet, 3 en desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 sm:gap-16">
      
      {items.map((item, index) => (
        <article class="group">
          {item.image && (
            <div class="relative overflow-hidden aspect-[4/3] mb-6">
              <!-- Imagen con zoom suave al pasar el mouse -->
              <img 
                src={item.image} 
                alt={item.name} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                onerror="this.src='https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&q=80&w=800'; this.onerror=null;"
              />
              <!-- Overlay sutil -->
              <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500"></div>
            </div>
          )}

          <div class="space-y-3">
            <div class="flex justify-between items-start gap-4">
              <h3 class="text-xl sm:text-2xl font-cinzel tracking-wide uppercase leading-tight">
                {item.name}
              </h3>
              <span class="text-orange-600 font-bold text-xl sm:text-2xl">
                ${item.price}
              </span>
            </div>
            
            <p class="text-neutral-400 text-sm sm:text-base italic leading-relaxed font-light">
              {item.description}
            </p>

            {item.tags && item.tags.length > 0 && (
              <div class="pt-2 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="inline-block border border-orange-900/30 bg-orange-950/10 text-[10px] sm:text-xs px-3 py-1 text-orange-500 uppercase tracking-[0.2em] font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}

    </div>
  </div>
</section>
