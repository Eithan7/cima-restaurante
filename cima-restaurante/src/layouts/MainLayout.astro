---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title = "CIMA | Alta Gastronomía en la Montaña", description = "Disfruta de la mejor cocina de altura en una experiencia premium inmersiva." } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
    
    <!-- Fuentes Google: Montserrat para títulos grandes, Outfit para lecturas, Great Vibes para cursiva -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=Outfit:wght@200;300;400;500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0a0a0a] text-neutral-300 flex flex-col min-h-screen selection:bg-orange-500 selection:text-[#0a0a0a] overflow-x-hidden">
    
    <!-- Editorial Side Decorations (Fixed) -->
    <div class="fixed left-4 md:left-8 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col items-center gap-24 pointer-events-none opacity-30 mix-blend-difference">
      <span class="vertical-text text-[10px] tracking-[0.4em] uppercase text-white font-light">Elevación 1900m</span>
      <div class="w-[1px] h-24 bg-white/50"></div>
    </div>
    
    <div class="fixed right-4 md:right-8 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col items-center gap-24 pointer-events-none opacity-30 mix-blend-difference">
      <div class="w-[1px] h-24 bg-white/50"></div>
      <span class="vertical-text text-[10px] tracking-[0.4em] uppercase text-white font-light">Est. 2024</span>
    </div>

    <Navbar />
    <main class="flex-grow pt-24 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
