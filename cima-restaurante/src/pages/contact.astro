---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ReservationBox from '../components/ReservationBox.astro';
---

<MainLayout title="Reservaciones | CIMA">
  <Hero 
    title="Reservaciones" 
    subtitle="Asegure su experiencia en las alturas"
    imagePath="https://images.unsplash.com/photo-1552566626-52f8b828add9?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80"
    size="medium"
  />

  <div class="bg-[#0a0a0a] py-32">
    <div class="w-full max-w-[1400px] mx-auto px-6 lg:px-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">
        
        <!-- Info column -->
        <div class="space-y-16 animate-fade-in opacity-0" style="animation-delay: 0.2s;">
          <div>
            <h2 class="text-4xl md:text-5xl font-cinzel text-white uppercase tracking-[0.1em] mb-6">Información</h2>
            <div class="w-16 h-[2px] bg-gold-500 mb-8"></div>
            <p class="text-neutral-400 font-light leading-relaxed max-w-sm text-lg">
              Debido a la naturaleza íntima de nuestro comedor, las reservaciones son altamente recomendadas y se pueden hacer con hasta 60 días de anticipación.
            </p>
          </div>
          
          <div class="space-y-10">
            <div>
              <h3 class="text-xs font-semibold text-white uppercase tracking-[0.2em] mb-3">Encuéntrenos</h3>
              <p class="text-neutral-400 font-light text-sm">123 Ruta del Bosque Mágico<br/>Banff, AB T1L 1E1</p>
            </div>
            
            <div>
              <h3 class="text-xs font-semibold text-white uppercase tracking-[0.2em] mb-3">Contáctenos</h3>
              <p class="text-neutral-400 font-light text-sm hover:text-orange-500 transition-colors duration-300">
                <a href="tel:+14035550199">(403) 555-0199</a>
              </p>
              <p class="text-neutral-400 font-light text-sm hover:text-orange-500 transition-colors duration-300 mt-1">
                <a href="mailto:reservations@cima.com">reservations@cima.com</a>
              </p>
            </div>
            
            <div>
              <h3 class="text-xs font-semibold text-white uppercase tracking-[0.2em] mb-3">Código de Vestimenta</h3>
              <p class="text-neutral-400 font-light text-sm max-w-sm">
                Sugerimos vestimenta casual elegante (smart casual). Agradecemos evitar el uso de ropa deportiva o técnica en el comedor principal.
              </p>
            </div>
          </div>
        </div>

        <!-- Reservation widget -->
        <div class="relative animate-fade-in opacity-0" style="animation-delay: 0.4s;">
          <div class="absolute inset-0 bg-orange-500/10 transform translate-x-4 translate-y-4 blur-sm"></div>
          <div class="relative">
             <ReservationBox />
          </div>
        </div>

      </div>
    </div>
  </div>
</MainLayout>
