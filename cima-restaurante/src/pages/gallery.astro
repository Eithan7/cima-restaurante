---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';

const images = [
  { url: "https://images.unsplash.com/photo-1544148103-0773bf10d330?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "md:col-span-2", rowSpan: "md:row-span-2", caption: "Salón Principal - Experiencia Gastronómica" },
  { url: "https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "col-span-1", rowSpan: "row-span-1", caption: "Bar & Cava - Selección Exclusiva" },
  { url: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "col-span-1", rowSpan: "row-span-1", caption: "Mesa del Chef - Ocula Privada" },
  { url: "https://images.unsplash.com/photo-1574936145840-28808d77a0b6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "col-span-1", rowSpan: "md:row-span-2", caption: "Lounge - Cócteles Artesanales" },
  { url: "https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "md:col-span-2", rowSpan: "row-span-1", caption: "Terraza Panorámica - Vista al Valle" },
  { url: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?ixlib=rb-4.0.3&auto=format&fit=crop&w=1080&q=80", colSpan: "col-span-1", rowSpan: "row-span-1", caption: "Cava - Colección Premium" }
];
---

<MainLayout title="Atmósfera | CIMA">
  <Hero 
    title="Atmósfera" 
    subtitle="Un espacio donde la arquitectura minimalista se rinde ante la inmensidad del paisaje"
    imagePath="https://images.unsplash.com/photo-1424847651672-bf20a4b0982b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80"
    size="medium"
  />

  <div class="bg-[#0a0a0a] py-32 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-[1400px] mx-auto px-6">
      
      <!-- Asymmetric Premium Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 auto-rows-[300px] gap-4 md:gap-8">
        {images.map((img, index) => (
          <figure class={`group relative overflow-hidden bg-[#111] animate-fade-in opacity-0 ${img.colSpan} ${img.rowSpan}`} style={`animation-delay: ${index * 0.15}s;`}>
            <img 
              src={img.url} 
              alt={img.caption} 
              loading="lazy"
              class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transform hover:scale-105 transition-all duration-1000 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            
            <figcaption class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 z-20 translate-y-2 sm:translate-y-4 opacity-100 sm:opacity-0 sm:group-hover:translate-y-0 sm:group-hover:opacity-100 transition-all duration-500">
              <div class="flex items-center space-x-2 sm:space-x-3">
                <div class="w-4 sm:w-8 h-[1px] bg-orange-500"></div>
                <span class="text-white font-cinzel tracking-widest uppercase text-xs sm:text-sm md:text-base drop-shadow-lg">{img.caption}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
      
    </div>
  </div>
</MainLayout>
